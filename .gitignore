# ===========================
# Dependencies
# ===========================
node_modules/
.pnp
.pnp.js

# ===========================
# Build outputs
# ===========================
dist/
out/
build/
release/
coverage/

# Electron bundles: esbuild output from electron/main.ts and electron/preload.ts.
# Regenerated by `npm run build:electron` (and by `npm run dev`), so they are
# never committed — a stale committed bundle would silently ship old code.
electron/main.cjs
electron/preload.cjs

# Application icons: generated from assets/logo-clear.svg by `npm run generate:icons`.
assets/icons/
assets/icon.png
assets/icon.ico
assets/icon.icns

